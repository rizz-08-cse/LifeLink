# Server Port
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas URI)
# Do not commit real credentials or production connection strings to version control
MONGODB_URI=mongodb://127.0.0.1:27017/lifelink

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=30d

# Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
